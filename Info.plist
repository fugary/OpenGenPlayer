<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Gen Player</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GENPLAYER_GOOGLE_CALLBACK_SCHEME)</string>
				<string>genplayer</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Gen Player Supported Files</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.audio</string>
				<string>public.image</string>
				<string>public.folder</string>
				<string>public.text</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_smb._tcp</string>
		<string>_webdav._tcp</string>
		<string>_webdavs._tcp</string>
		<string>_ftp._tcp</string>
		<string>_sftp._tcp</string>
		<string>_sftp-ssh._tcp</string>
		<string>_ssh._tcp</string>
		<string>_nfs._tcp</string>
		<string>_nfs._udp</string>
		<string>_mountd._tcp</string>
		<string>_jellyfin._tcp</string>
		<string>_jellyfin-server._tcp</string>
		<string>_emby-server._tcp</string>
		<string>_embyserver._tcp</string>
		<string>_plexmediasvr._tcp</string>
		<string>_plexmediaserver._tcp</string>
		<string>_plex._tcp</string>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Use the camera to scan TV authorization QR codes.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to verify your identity and protect your data.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Gen Player needs local network access to discover and connect to SMB, WebDAV, FTP, SFTP, NFS, Jellyfin, Emby, and Plex servers.</string>
	<key>UIAppFonts</key>
	<array>
		<string>SourceHanSansSC-Regular.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>GenPlayerGoogleClientID</key>
	<string>$(GENPLAYER_GOOGLE_CLIENT_ID)</string>
	<key>GenPlayerGoogleDeviceClientID</key>
	<string>$(GENPLAYER_GOOGLE_DEVICE_CLIENT_ID)</string>
	<key>GenPlayerGoogleDeviceClientSecret</key>
	<string>$(GENPLAYER_GOOGLE_DEVICE_CLIENT_SECRET)</string>
	<key>GenPlayerGoogleCallbackScheme</key>
	<string>$(GENPLAYER_GOOGLE_CALLBACK_SCHEME)</string>
	<key>GenPlayerOneDriveClientID</key>
	<string>$(GENPLAYER_ONEDRIVE_CLIENT_ID)</string>
</dict>
</plist>
