 static vlc_tick_t ClockGetTsOffset( input_clock_t * );
 
+static void ClockClearRateHistory( input_clock_t *cl )
+{
+    while( cl->rate_history )
+    {
+        clock_rate_segment_t *segment = cl->rate_history;
+        cl->rate_history = segment->next;
+        free( segment );
+    }
+}
+
+static void ClockRememberRate( input_clock_t *cl, vlc_tick_t i_system )
+{
+    const vlc_tick_t now = cl->b_paused ? cl->i_pause_date : mdate();
+    while( cl->rate_history && cl->rate_history->end.i_system < now - CR_MEAN_PTS_GAP )
+    {
+        clock_rate_segment_t *expired = cl->rate_history;
+        cl->rate_history = expired->next;
+        free( expired );
+    }
+
+    clock_rate_segment_t **tail = &cl->rate_history;
+    while( *tail )
+    {
+        /* Changes before another audio block only replace the pending rate. */
+        if( (*tail)->end.i_stream == cl->i_audio_end )
+            return;
+        if( (*tail)->end.i_stream > cl->i_audio_end )
+        {
+            ClockClearRateHistory( cl );
+            tail = &cl->rate_history;
+            break;
+        }
+        tail = &(*tail)->next;
+    }
+    clock_rate_segment_t *segment = malloc( sizeof(*segment) );
+    if( !segment )
+        return;
+    *segment = (clock_rate_segment_t) {
+        .end = clock_point_Create( cl->i_audio_end, i_system ),
+        .i_rate = cl->i_rate,
+        .next = NULL,
+    };
+    *tail = segment;
+}
+
+static void ClockShiftRateHistory( input_clock_t *cl, vlc_tick_t offset )
+{
+    for( clock_rate_segment_t *segment = cl->rate_history; segment; segment = segment->next )
+        segment->end.i_system += offset;
+}
+
+static vlc_tick_t ClockPresentationDate( input_clock_t *cl, vlc_tick_t ts, int *rate )
+{
+    for( clock_rate_segment_t *segment = cl->rate_history; segment; segment = segment->next )
+    {
+        if( ts < segment->end.i_stream )
+        {
+            if( rate )
+                *rate = segment->i_rate;
+            return segment->end.i_system +
+                ( ts - segment->end.i_stream ) * segment->i_rate / INPUT_RATE_DEFAULT;
+        }
+    }
+    if( rate )
+        *rate = cl->i_rate;
+    return ClockStreamToSystem( cl, ts + AvgGet( &cl->drift ) ) +
+        cl->i_pts_delay + ClockGetTsOffset( cl );
+}
