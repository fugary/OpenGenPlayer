+/* Presentation mappings for audio queued before a rate change. Video decoding
+ * can lag behind audio submission, so it must retain each old mapping until
+ * it reaches the same stream-time boundary. */
+typedef struct clock_rate_segment_t
+{
+    clock_point_t end;
+    int i_rate;
+    struct clock_rate_segment_t *next;
+} clock_rate_segment_t;
